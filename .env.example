# Auth App Environment Variables

NODE_ENV=development
DATABASE_URL=file:./auth.db
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-here
BETTER_AUTH_URL=http://localhost:3001
VITE_UI_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
# Comma-separated extra trusted origins (e.g. Kong gateway URL)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8000
